# Copy to `.env` and adjust for your machine.
#
# DATABASE_URL must use a PostgreSQL role that exists on your server.
# The old placeholder `user:password` often fails with: role "user" does not exist.
#
# Examples (pick one that matches your Postgres install):
#   postgresql+asyncpg://postgres@localhost:5432/summercamp
#   postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/summercamp
#   postgresql+asyncpg://YOUR_OS_USERNAME@localhost:5432/summercamp
#
# Create DB if needed: createdb summercamp
# Then run migrations: alembic upgrade head

DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/summercamp
SECRET_KEY=change-me-in-production
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development
ADMIN_API_KEY=

# Cloudflare R2 — use S3-compatible keys from: R2 → Manage R2 API Tokens (not the global CF API token).
# Do not set R2_API_TOKEN here; boto3 needs the access key id + secret pair below.
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# Public URL for objects (no trailing slash), e.g. https://pub-xxxxx.r2.dev
# R2_PUBLIC_BASE_URL=
# Optional: Cloudflare Image Resizing zone for WebP, e.g. https://yourdomain.com/cdn-cgi/image
# R2_IMAGE_TRANSFORM_BASE=
